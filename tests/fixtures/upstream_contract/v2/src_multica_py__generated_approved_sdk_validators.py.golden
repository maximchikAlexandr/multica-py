from __future__ import annotations



def normalize_optional_label(s: str) -> None:
    return

def validate_comment_cursor(s: str) -> None:
    if not s.strip():
        raise ValueError(f'{__name__}.validate_comment_cursor: blank value')

def validate_description_input(s: str) -> None:
    raise ValueError(f'{__name__}.validate_description_input: validation failed for {s!r}')

def validate_issue_sort(s: str) -> None:
    if s.strip() not in ("position", "title", "created_at", "start_date", "due_date", "priority"):
        raise ValueError(f'{__name__}.validate_issue_sort: invalid sort {s!r}')

def validate_issue_status(s: str) -> None:
    if s.strip() not in ("backlog", "todo", "in_progress", "in_review", "done", "blocked", "cancelled"):
        raise ValueError(f'{__name__}.validate_issue_status: invalid status {s!r}')

def validate_nonblank(s: str) -> None:
    if not s.strip():
        raise ValueError(f'{__name__}.validate_nonblank: value is blank')

def validate_nonnegative_limit(s: str) -> None:
    val = int(s)
    if val < 0:
        raise ValueError(f'{__name__}.validate_nonnegative_limit: negative value {s!r}')

def validate_positive_limit(s: str) -> None:
    val = int(s)
    if val <= 0:
        raise ValueError(f'{__name__}.validate_positive_limit: non-positive value {s!r}')

def validate_project_description(s: str) -> None:
    raise ValueError(f'{__name__}.validate_project_description: validation failed for {s!r}')

def validate_project_status(s: str) -> None:
    if s.strip() not in ("planned", "in_progress", "paused", "completed", "cancelled"):
        raise ValueError(f'{__name__}.validate_project_status: invalid status {s!r}')

def validate_project_update(s: str) -> None:
    raise ValueError(f'{__name__}.validate_project_update: validation failed for {s!r}')

def validate_resource_update(s: str) -> None:
    raise ValueError(f'{__name__}.validate_resource_update: validation failed for {s!r}')

def validate_thread_cursor_limit(s: str) -> None:
    val = int(s)
    if val <= 0:
        raise ValueError(f'{__name__}.validate_thread_cursor_limit: non-positive value {s!r}')

