from __future__ import annotations

from enum import StrEnum


class IssueSort(StrEnum):
    position = 'position'
    title = 'title'
    created_at = 'created_at'
    start_date = 'start_date'
    due_date = 'due_date'
    priority = 'priority'


class SortDirection(StrEnum):
    asc = 'asc'
    desc = 'desc'

